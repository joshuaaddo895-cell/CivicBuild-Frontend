# Base URL for the Spring Boot backend (no trailing slash).
# Physical device on same Wi-Fi: use your dev machine LAN IP, e.g. http://192.168.x.x:8081
# Android emulator: config helper auto-uses http://10.0.2.2:8081 in __DEV__
# iOS simulator: config helper auto-uses http://localhost:8081 in __DEV__
EXPO_PUBLIC_API_URL=http://192.168.0.0:8081
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_PROJECT_ID=your-eas-project-id
# Checkout uses mock Paystack flow in development. Set to "false" when backend is ready.
EXPO_PUBLIC_USE_MOCK_CHECKOUT=true
# Google OAuth client IDs (from Google Cloud Console)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
