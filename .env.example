# Base URL for the Spring Boot backend (no trailing slash).
# Copy to .env.development (gitignored) — never commit real URLs or secrets here.
# Local LAN example: http://192.168.x.x:8081
# Production example: https://your-app.up.railway.app
EXPO_PUBLIC_API_URL=https://your-backend.example.com
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_PROJECT_ID=your-eas-project-id
# Checkout uses mock Paystack flow only when explicitly enabled.
EXPO_PUBLIC_USE_MOCK_CHECKOUT=false
# Google OAuth client IDs (from Google Cloud Console)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Required for `npm run start:tunnel` — install ngrok v3 CLI first: winget install ngrok.ngrok
# Token: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
